{
  // markdownlint-cli2 configuration. Run: npm run docs:lint (or docs:lint:fix)
  "config": {
    "default": true,
    // Prose is written one sentence or paragraph per line; do not hard-wrap.
    "MD013": false,
    // Repeated headings are fine in different sections (e.g. "Consequences" in ADRs).
    "MD024": { "siblings_only": true },
    // Allow the few inline HTML elements we use in docs and Mermaid labels.
    "MD033": { "allowed_elements": ["br", "details", "summary"] },
    // Frontmatter-only first lines are fine.
    "MD041": false,
    "MD004": { "style": "dash" },
    "MD029": { "style": "one_or_ordered" },
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    // Generated by `openspec init/update`; regenerated, not hand-edited.
    ".claude/commands/opsx/**",
    ".claude/skills/openspec-*/**",
    ".agents/skills/openspec-*/**",
    ".github/prompts/opsx-*",
    ".github/skills/openspec-*/**",
    ".cursor/**",
    ".gemini/**",
    // Specs and changes are formatted by OpenSpec (`openspec archive` rewrites specs) and
    // checked by `openspec validate --strict`; their own AGENTS.md is still linted.
    "openspec/specs/**",
    "openspec/changes/**"
  ]
}
